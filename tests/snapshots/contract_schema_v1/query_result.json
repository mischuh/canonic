{
  "$defs": {
    "Compiled": {
      "description": "The compiled SQL and its dialect (SPEC \u00a72.2 ``compiled``).",
      "properties": {
        "sql": {
          "title": "Sql",
          "type": "string"
        },
        "dialect": {
          "title": "Dialect",
          "type": "string"
        }
      },
      "required": [
        "sql",
        "dialect"
      ],
      "title": "Compiled",
      "type": "object"
    },
    "CompositionComponentOut": {
      "description": "One side of a composite metric: its binding and the population it counts.",
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "resolved": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved"
        },
        "population_filter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Filter"
        }
      },
      "required": [
        "metric"
      ],
      "title": "CompositionComponentOut",
      "type": "object"
    },
    "CompositionOut": {
      "description": "How one composite metric (``ratio``, ``weighted_avg``) was formed for this query.\n\n``on_zero_denominator`` is the policy applied to a row with a zero denominator. Under\n``zero`` that row becomes ``0`` without any warning, so a caller needs it here to tell a\nreal zero from a substituted one. ``zero_denominator_rows`` is how many rows of the returned\nresult had a zero denominator and were given the policy's value. It is ``None`` when it was\nnot counted: without an executed result, and under ``on_zero_denominator: error``.\n``numerator_parts`` lists the disjoint metrics declared to sum to the numerator, ``None``\nwhen none are declared.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "numerator": {
          "$ref": "#/$defs/CompositionComponentOut"
        },
        "denominator": {
          "$ref": "#/$defs/CompositionComponentOut"
        },
        "on_zero_denominator": {
          "title": "On Zero Denominator",
          "type": "string"
        },
        "zero_denominator_rows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zero Denominator Rows"
        },
        "numerator_parts": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator Parts"
        }
      },
      "required": [
        "kind",
        "numerator",
        "denominator",
        "on_zero_denominator"
      ],
      "title": "CompositionOut",
      "type": "object"
    },
    "CumulativeOut": {
      "description": "How a cumulative metric's running total was formed for this query.\n\n``partition_by`` is every requested dimension that is not an order dimension, so it\ndiffers per query. Under ``history: exclude`` the total starts at zero at the first row\nthat passes the query's filters. Under ``include`` it runs from the first row of data, and\n``visibility_filters`` only chose which order tuples are shown.",
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "order_by": {
          "items": {
            "type": "string"
          },
          "title": "Order By",
          "type": "array"
        },
        "partition_by": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Partition By",
          "type": "array"
        },
        "on_gap": {
          "title": "On Gap",
          "type": "string"
        },
        "history": {
          "title": "History",
          "type": "string"
        },
        "visibility_filters": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Visibility Filters",
          "type": "array"
        },
        "window": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        },
        "grain_to_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grain To Date"
        },
        "period_agg": {
          "default": "last",
          "title": "Period Agg",
          "type": "string"
        },
        "lookback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lookback"
        }
      },
      "required": [
        "metric",
        "order_by",
        "on_gap",
        "history"
      ],
      "title": "CumulativeOut",
      "type": "object"
    },
    "DerivedDefinitionOut": {
      "description": "How a derived metric is computed: ``expr`` over its ``inputs``, per output row.",
      "properties": {
        "expr": {
          "title": "Expr",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/DerivedInputOut"
          },
          "title": "Inputs",
          "type": "array"
        },
        "on_zero_denominator": {
          "title": "On Zero Denominator",
          "type": "string"
        }
      },
      "required": [
        "expr",
        "inputs",
        "on_zero_denominator"
      ],
      "title": "DerivedDefinitionOut",
      "type": "object"
    },
    "DerivedInputOut": {
      "description": "One input of a derived metric: the name ``expr`` uses, and the metric behind it.",
      "properties": {
        "alias": {
          "title": "Alias",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "resolved": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved"
        }
      },
      "required": [
        "alias",
        "metric"
      ],
      "title": "DerivedInputOut",
      "type": "object"
    },
    "FinalityOut": {
      "description": "Finality metadata block in a query response (SPEC-E5-E15 stage 8).",
      "properties": {
        "watermark": {
          "title": "Watermark",
          "type": "string"
        },
        "sources_used": {
          "items": {
            "type": "string"
          },
          "title": "Sources Used",
          "type": "array"
        },
        "final_rows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Rows"
        },
        "provisional_rows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provisional Rows"
        }
      },
      "required": [
        "watermark",
        "sources_used"
      ],
      "title": "FinalityOut",
      "type": "object"
    },
    "FiredGuardrailOut": {
      "description": "A guardrail that fired during compilation (mirrors compiler ``FiredGuardrail``).\n\n``predicate`` is the filter or constraint it applied. ``knowledge_refs`` are the ids of the\nknowledge pages that explain it, readable with ``read_knowledge_page``.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "title": "Severity",
          "type": "string"
        },
        "predicate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate"
        },
        "knowledge_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Knowledge Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "FiredGuardrailOut",
      "type": "object"
    },
    "OffsetOut": {
      "description": "How one offset metric was shifted for this query.\n\n``shifted_filters`` are the query filters evaluated on the shifted column, in output time.",
      "properties": {
        "base": {
          "title": "Base",
          "type": "string"
        },
        "time_dimension": {
          "title": "Time Dimension",
          "type": "string"
        },
        "offset": {
          "title": "Offset",
          "type": "string"
        },
        "shifted_filters": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Shifted Filters",
          "type": "array"
        }
      },
      "required": [
        "base",
        "time_dimension",
        "offset"
      ],
      "title": "OffsetOut",
      "type": "object"
    },
    "QueryMetadata": {
      "description": "The E5 compiler metadata block carried alongside a result (SPEC \u00a72.2).",
      "properties": {
        "resolved": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Resolved",
          "type": "object"
        },
        "guardrails_fired": {
          "items": {
            "$ref": "#/$defs/FiredGuardrailOut"
          },
          "title": "Guardrails Fired",
          "type": "array"
        },
        "freshness": {
          "items": {
            "$ref": "#/$defs/SourceFreshnessOut"
          },
          "title": "Freshness",
          "type": "array"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "contract_schema": {
          "default": "3.13",
          "title": "Contract Schema",
          "type": "string"
        },
        "finality": {
          "anyOf": [
            {
              "$ref": "#/$defs/FinalityOut"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "related": {
          "$ref": "#/$defs/RelatedOut",
          "default": {
            "unused_dimensions": [],
            "sibling_metrics": []
          }
        },
        "trust_score": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrustScoreOut"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScopeOut"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cumulative": {
          "anyOf": [
            {
              "$ref": "#/$defs/CumulativeOut"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRangeOut"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "offset": {
          "additionalProperties": {
            "$ref": "#/$defs/OffsetOut"
          },
          "default": {},
          "title": "Offset",
          "type": "object"
        },
        "derived": {
          "additionalProperties": {
            "$ref": "#/$defs/DerivedDefinitionOut"
          },
          "default": {},
          "title": "Derived",
          "type": "object"
        },
        "composition": {
          "additionalProperties": {
            "$ref": "#/$defs/CompositionOut"
          },
          "default": {},
          "title": "Composition",
          "type": "object"
        },
        "project_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Fingerprint"
        }
      },
      "required": [
        "resolved",
        "guardrails_fired",
        "freshness"
      ],
      "title": "QueryMetadata",
      "type": "object"
    },
    "RelatedDimensionOut": {
      "description": "An unused queryable dimension surfaced in ``metadata.related`` (SPEC-E7/E8 \u00a72.2).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "RelatedDimensionOut",
      "type": "object"
    },
    "RelatedMetricOut": {
      "description": "An active sibling metric surfaced in ``metadata.related`` (SPEC-E7/E8 \u00a72.2).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "RelatedMetricOut",
      "type": "object"
    },
    "RelatedOut": {
      "description": "The ``metadata.related`` block: unused dimensions and sibling metrics (SPEC-E7/E8 \u00a72.2).",
      "properties": {
        "unused_dimensions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RelatedDimensionOut"
          },
          "title": "Unused Dimensions",
          "type": "array"
        },
        "sibling_metrics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RelatedMetricOut"
          },
          "title": "Sibling Metrics",
          "type": "array"
        }
      },
      "title": "RelatedOut",
      "type": "object"
    },
    "ResultColumn": {
      "description": "A single column descriptor in a ResultSet.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "ResultColumn",
      "type": "object"
    },
    "ResultSet": {
      "description": "Normalized query result emitted by run_read_only_sql().",
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/ResultColumn"
          },
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {},
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "bytes_scanned": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Scanned"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "ResultSet",
      "type": "object"
    },
    "ScopeOut": {
      "description": "The ``metadata.scope`` block: tenant/role scoping (SPEC-E12 \u00a73 stage 8, S16 AC3).",
      "properties": {
        "tenant": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant"
        },
        "scoped_sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scoped Sources",
          "type": "array"
        },
        "shared_sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Shared Sources",
          "type": "array"
        },
        "roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "tenancy_exempt": {
          "default": false,
          "title": "Tenancy Exempt",
          "type": "boolean"
        }
      },
      "title": "ScopeOut",
      "type": "object"
    },
    "SourceFreshnessOut": {
      "description": "Per-source freshness metadata (mirrors compiler ``SourceFreshness``).",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "last_validated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Validated At"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        }
      },
      "required": [
        "source"
      ],
      "title": "SourceFreshnessOut",
      "type": "object"
    },
    "TimeRangeOut": {
      "description": "The query's ``time_range`` resolved to dates, ``start`` inclusive and ``end`` exclusive.\n\n``anchor`` is the instant ``last`` was counted back from, ``as_of`` or the compile time.",
      "properties": {
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "last": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last"
        },
        "include_current": {
          "default": false,
          "title": "Include Current",
          "type": "boolean"
        },
        "anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor"
        }
      },
      "required": [
        "dimension"
      ],
      "title": "TimeRangeOut",
      "type": "object"
    },
    "TrustScoreOut": {
      "description": "The ``metadata.trust_score`` block: tier + capping reasons (SPEC-E14 \u00a73, \u00a76).",
      "properties": {
        "tier": {
          "title": "Tier",
          "type": "string"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "tier"
      ],
      "title": "TrustScoreOut",
      "type": "object"
    }
  },
  "description": "The combined ``query`` response: ``result`` + ``compiled`` + ``metadata`` (SPEC \u00a72.2).",
  "properties": {
    "result": {
      "$ref": "#/$defs/ResultSet"
    },
    "compiled": {
      "$ref": "#/$defs/Compiled"
    },
    "metadata": {
      "$ref": "#/$defs/QueryMetadata"
    }
  },
  "required": [
    "result",
    "compiled",
    "metadata"
  ],
  "title": "QueryResult",
  "type": "object"
}
