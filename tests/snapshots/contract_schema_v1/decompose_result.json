        "inputs",
        "on_zero_denominator"
      ],
      "title": "DerivedDefinitionOut",
      "type": "object"
    },
    "DerivedInputOut": {
      "description": "One input of a derived metric: the name ``expr`` uses, and the metric behind it.",
      "properties": {
        "alias": {
          "title": "Alias",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "resolved": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved"
        }
      },
      "required": [
        "alias",
        "metric"
      ],
      "title": "DerivedInputOut",
      "type": "object"
    },
    "Effect": {
      "description": "One overall effect of a ratio change, in the metric's units.\n\n``metric`` is the numerator, the denominator or the part the effect belongs to, and\n``base``/``compare`` are that metric's own values.",
      "properties": {
        "effect": {
          "$ref": "#/$defs/EffectKind"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "base": {
          "title": "Base",
          "type": "number"
        },
        "compare": {
          "title": "Compare",
          "type": "number"
        },
        "contribution": {
          "title": "Contribution",
          "type": "number"
        }
      },
      "required": [
        "effect",
        "metric",
        "base",
        "compare",
        "contribution"
      ],
      "title": "Effect",
      "type": "object"
    },
    "EffectKind": {
      "description": "One overall effect of a ratio change.",
      "enum": [
        "numerator",
        "denominator",
        "part"
      ],
      "title": "EffectKind",
      "type": "string"
    },
    "FinalityOut": {
      "description": "Finality metadata block in a query response (SPEC-E5-E15 stage 8).",
      "properties": {
        "watermark": {
          "title": "Watermark",
          "type": "string"
        },
        "sources_used": {
          "items": {
            "type": "string"
          },
          "title": "Sources Used",
          "type": "array"
        },
