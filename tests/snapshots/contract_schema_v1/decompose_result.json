{
  "$defs": {
    "AdditiveBreakdown": {
      "description": "The change split by the members of one dimension. ``residual`` is what the rows miss.",
      "properties": {
        "rows": {
          "items": {
            "$ref": "#/$defs/AdditiveRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "residual": {
          "title": "Residual",
          "type": "number"
        }
      },
      "required": [
        "rows",
        "residual"
      ],
      "title": "AdditiveBreakdown",
      "type": "object"
    },
    "AdditiveRow": {
      "description": "One member's values and its contribution to the change.\n\nA row with ``rest: true`` merges every member beyond ``top_n``. Its ``member`` is ``null``.",
      "properties": {
        "member": {
          "title": "Member"
        },
        "base": {
          "title": "Base",
          "type": "number"
        },
        "compare": {
          "title": "Compare",
          "type": "number"
        },
        "contribution": {
          "title": "Contribution",
          "type": "number"
        },
        "rest": {
          "default": false,
          "title": "Rest",
          "type": "boolean"
        }
      },
      "required": [
        "member",
        "base",
        "compare",
        "contribution"
      ],
      "title": "AdditiveRow",
      "type": "object"
    },
    "CompositionComponentOut": {
      "description": "One side of a composite metric: its binding and the population it counts.",
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "resolved": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved"
        },
        "population_filter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Filter"
        }
      },
      "required": [
        "metric"
      ],
      "title": "CompositionComponentOut",
      "type": "object"
    },
    "CompositionOut": {
      "description": "How one composite metric (``ratio``, ``weighted_avg``) was formed for this query.\n\n``on_zero_denominator`` is the policy applied to a row with a zero denominator. Under\n``zero`` that row becomes ``0`` without any warning, so a caller needs it here to tell a\nreal zero from a substituted one. ``zero_denominator_rows`` is how many rows of the returned\nresult had a zero denominator and were given the policy's value. It is ``None`` when it was\nnot counted: without an executed result, and under ``on_zero_denominator: error``.\n``numerator_parts`` lists the disjoint metrics declared to sum to the numerator, ``None``\nwhen none are declared.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "numerator": {
          "$ref": "#/$defs/CompositionComponentOut"
        },
        "denominator": {
          "$ref": "#/$defs/CompositionComponentOut"
        },
        "on_zero_denominator": {
          "title": "On Zero Denominator",
          "type": "string"
        },
        "zero_denominator_rows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zero Denominator Rows"
        },
        "numerator_parts": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator Parts"
        }
      },
      "required": [
        "kind",
        "numerator",
        "denominator",
        "on_zero_denominator"
      ],
      "title": "CompositionOut",
      "type": "object"
    },
    "ConversionDefinitionOut": {
      "description": "How a conversion metric matches conversion events to the base events of its entity.\n\nEach conversion event counts for the latest base event of the same ``entity`` at or before\nit, within ``window`` when one is set, and is reported under that base event's dimensions.",
      "properties": {
        "base_metric": {
          "title": "Base Metric",
          "type": "string"
        },
        "conversion_metric": {
          "title": "Conversion Metric",
          "type": "string"
        },
        "entity": {
          "$ref": "#/$defs/ConversionPairOut"
        },
        "base_time": {
          "title": "Base Time",
          "type": "string"
        },
        "conversion_time": {
          "title": "Conversion Time",
          "type": "string"
        },
        "window": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        },
        "calculation": {
          "title": "Calculation",
          "type": "string"
        },
        "constant_properties": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ConversionPairOut"
          },
          "title": "Constant Properties",
          "type": "array"
        },
        "attribution": {
          "default": "last_touch",
          "title": "Attribution",
          "type": "string"
        }
      },
      "required": [
        "base_metric",
        "conversion_metric",
        "entity",
        "base_time",
        "conversion_time",
        "calculation"
      ],
      "title": "ConversionDefinitionOut",
      "type": "object"
    },
    "ConversionPairOut": {
      "description": "A column of a conversion metric, named on the base and on the conversion side.",
      "properties": {
        "base": {
          "title": "Base",
          "type": "string"
        },
        "conversion": {
          "title": "Conversion",
          "type": "string"
        }
      },
      "required": [
        "base",
        "conversion"
      ],
      "title": "ConversionPairOut",
      "type": "object"
    },
    "CumulativeOut": {
      "description": "How a cumulative metric's running total was formed for this query.\n\n``partition_by`` is every requested dimension that is not an order dimension, so it\ndiffers per query. Under ``history: exclude`` the total starts at zero at the first row\nthat passes the query's filters. Under ``include`` it runs from the first row of data, and\n``visibility_filters`` only chose which order tuples are shown.",
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "order_by": {
          "items": {
            "type": "string"
          },
          "title": "Order By",
          "type": "array"
        },
        "partition_by": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Partition By",
          "type": "array"
        },
        "on_gap": {
          "title": "On Gap",
          "type": "string"
        },
        "history": {
          "title": "History",
          "type": "string"
        },
        "visibility_filters": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Visibility Filters",
          "type": "array"
        },
        "window": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        },
        "grain_to_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grain To Date"
        },
        "period_agg": {
          "default": "last",
          "title": "Period Agg",
          "type": "string"
        },
        "lookback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lookback"
        }
      },
      "required": [
        "metric",
        "order_by",
        "on_gap",
        "history"
      ],
      "title": "CumulativeOut",
      "type": "object"
    },
    "DecomposeMethodName": {
      "description": "How the change was attributed, chosen by the binding kind.",
      "enum": [
        "additive",
        "ratio_shift_share",
        "ratio_parts"
      ],
      "title": "DecomposeMethodName",
      "type": "string"
    },
    "DecomposePeriod": {
      "description": "The two compared values of one time dimension. Their order only sets the sign.",
      "properties": {
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "base": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Base"
        },
        "compare": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Compare"
        }
      },
      "required": [
        "dimension",
        "base",
        "compare"
      ],
      "title": "DecomposePeriod",
      "type": "object"
    },
    "DenominatorBreakdown": {
      "description": "The denominator by member. These rows do not sum to the metric change.",
      "properties": {
        "units": {
          "const": "denominator",
          "default": "denominator",
          "title": "Units",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/DenominatorRow"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "rows"
      ],
      "title": "DenominatorBreakdown",
      "type": "object"
    },
    "DenominatorRow": {
      "description": "Where the denominator moved, in the denominator's own units.",
      "properties": {
        "member": {
          "title": "Member"
        },
        "base": {
          "title": "Base",
          "type": "number"
        },
        "compare": {
          "title": "Compare",
          "type": "number"
        },
        "delta": {
          "title": "Delta",
          "type": "number"
        },
        "rest": {
          "default": false,
          "title": "Rest",
          "type": "boolean"
        }
      },
      "required": [
        "member",
        "base",
        "compare",
        "delta"
      ],
      "title": "DenominatorRow",
      "type": "object"
    },
    "DerivedDefinitionOut": {
      "description": "How a derived metric is computed: ``expr`` over its ``inputs``, per output row.",
      "properties": {
        "expr": {
          "title": "Expr",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/DerivedInputOut"
          },
          "title": "Inputs",
          "type": "array"
        },
        "on_zero_denominator": {
