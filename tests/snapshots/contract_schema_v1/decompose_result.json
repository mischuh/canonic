          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "title": "Severity",
          "type": "string"
        },
        "predicate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate"
        },
        "knowledge_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Knowledge Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "FiredGuardrailOut",
      "type": "object"
    },
    "OffsetOut": {
      "description": "How one offset metric was shifted for this query.\n\n``shifted_filters`` are the query filters evaluated on the shifted column, in output time.",
      "properties": {
        "base": {
          "title": "Base",
          "type": "string"
        },
        "time_dimension": {
